{
  "name": "delivery",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx watch src/index.ts",
    "test": "jest --watchAll --no-cache",
    "test:ci": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "/redis$": "<rootDir>/src/__mocks__/redis.ts",
      "/nats-wrapper$": "<rootDir>/src/__mocks__/nats-wrapper.ts",
      "/otp-service$": "<rootDir>/src/__mocks__/otp-service.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    }
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@bloggie/library": "^1.0.12",
    "bullmq": "^6.3.11",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "node-nats-streaming": "^0.3.2",
    "nodemailer": "^10.0.15",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
