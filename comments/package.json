{
  "name": "comments",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "tsx watch src/index.ts",
    "test": "jest --watchAll --no-cache",
    "test:ci": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "/nats-wrapper$": "<rootDir>/src/__mocks__/nats-wrapper.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    }
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@bloggie/library": "^1.0.11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.96",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "mongoose": "^9.9.5",
    "node-nats-streaming": "^0.3.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
